# Flask Application Configuration
FLASK_ENV=development
SECRET_KEY=change_this_to_a_secure_random_key_in_production
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/meetiq

# Mail Server Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_app_password
MAIL_DEFAULT_SENDER=your_email@example.com

# CORS Configuration (comma-separated origins or * for development)
CORS_ALLOWED_ORIGINS=*

# AI Services & Ollama Configuration
OLLAMA_API_URL=http://localhost:11434
SUMMARIZER_MODEL=llama3
